# Site origin (no /api) — canonical URLs, sitemap, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://chaptersaurchai.com

# Google Analytics 4 — omit to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7NGVGV4QW8

# Public API — all fetch() calls use this host + /api/…
# Acceptable values: https://chaptersaurchai.com or https://chaptersaurchai.com/api (trailing /api is normalized).
# Production: set to your live API (same host as the site is fine).
# Local dev: leave unset to use same-origin /api (Next.js rewrites to the API), or use http://127.0.0.1:5001.
NEXT_PUBLIC_API_URL=https://chaptersaurchai.com/api

# Optional — SSR / build only, if the API is reachable on a different internal URL than NEXT_PUBLIC_API_URL.
# If unset, server-side requests use NEXT_PUBLIC_API_URL (then 127.0.0.1:5001 for local builds).
# Production (Bluehost): API_INTERNAL_URL=http://127.0.0.1:5002
# API_INTERNAL_URL=http://127.0.0.1:5001

# --- Frontend-only on localhost, data from production API (put in `.env.local`) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=https://chaptersaurchai.com/api
# API_INTERNAL_URL=https://chaptersaurchai.com/api
# Ensure the live API FRONTEND_URL includes `http://localhost:3000` or browser calls will be blocked by CORS.

# --- If the Network tab shows https://chaptersaurchai.com/api/... returning 500 from fetch(),
# but pasting that URL in the browser bar returns 200: the requests are not identical.
# A typed URL is a plain navigation; fetch from localhost sends Origin / Sec-Fetch-* etc., which some
# edges or WAF rules treat differently. Fix: do NOT set NEXT_PUBLIC_API_URL locally so the browser only
# calls http://localhost:3000/api/… — Next.js rewrites to production (set API_INTERNAL_URL for the rewrite
# target). Browser becomes same-origin; no cross-site fetch to the public host.
# Example `.env.local`:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   API_INTERNAL_URL=https://chaptersaurchai.com/api
#   (omit NEXT_PUBLIC_API_URL entirely, or comment it out)

# Image host — always used for /api/img/... (ignores NEXT_PUBLIC_SITE_URL so localhost:3000 never wins).
NEXT_PUBLIC_IMAGE_API_URL=https://chaptersaurchai.com

# --- Images (/api/img/...) ---
# Upload stores `/api/img/<token>` in the DB — not full URLs.
# Display URLs always resolve to https://chaptersaurchai.com/api/img/... (even when SITE_URL is localhost).
# New uploads from localhost only appear after they exist on the server (upload via prod admin or sync uploads/).
# Production: image files live in `apps/api/uploads/` on the server; deploy must keep that folder and
# JWT_SECRET must stay stable or old image tokens stop working.

# --- macOS: "EMFILE: too many open files" or every route 404 in dev ---
# 1) Stop Next, run: rm -rf apps/web/.next
# 2) Use polling watchers (fewer file descriptors): npm run dev:poll -w apps/web
#    Or raise limits in the same shell first: ulimit -n 10240
