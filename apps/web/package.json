{
  "name": "@chai-n-chapter/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start -p 5000",
    "start:prod": "NODE_ENV=production next start -p 5000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs chai-n-chapter-web",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker build -t chai-n-chapter-web:latest -f Dockerfile ../..",
    "docker:run": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f web"
  },
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
