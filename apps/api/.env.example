NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
# Links/images in subscriber emails (optional). If unset and FRONTEND_URL is localhost, emails use https://chaptersaurchai.com automatically.
# PUBLIC_SITE_URL=https://chaptersaurchai.com
# Must include database name so the API uses your chai-n-chapter DB (not default "test").
MONGODB_URI=mongodb+srv://thebookishvoyager:Reader%4012@chai-n-chapter.gvy1ste.mongodb.net/chai-n-chapter
JWT_SECRET=your-secret-key-change-in-production
# /api/img/:token URLs are HMAC-signed with JWT_SECRET. Use the same value as production if your DB has prod image tokens.
# Binary files are stored under apps/api/uploads/ (gitignored). Re-upload locally or copy that folder from the server.

# For seed-admin script (create first admin user). Copy this file to .env and set these there.
ADMIN_EMAIL=thebookishvoyager@gmail.com
ADMIN_PASSWORD="Reader@12"

# Subscriber emails (welcome + announcements). Prefer Admin → Subscriber emails, or set here for production.
# Bluehost: create read@chaptersaurchai.com in cPanel → Email Accounts, then use its password below.
SMTP_HOST=mail.chaptersaurchai.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=read@chaptersaurchai.com
SMTP_PASS=your-email-account-password
SMTP_FROM="Chapters.aur.Chai <read@chaptersaurchai.com>"

# Optional, local dev only (NODE_ENV=development): mail icon sends here instead of all subscribers.
# Do NOT set on the production server. Production always emails all subscribed users.
# ANNOUNCE_TEST_ONLY=you@example.com

# ── Library OS: AI (optional) ──
# FREE / free-tier only in default order — you will not be charged unless you
# add a paid provider key AND put it in AI_PROVIDER_ORDER.
#
# Free-tier: Gemini, Groq, OpenRouter (:free models), Cerebras
# Paid (leave unset for now): DeepSeek, Mistral, OpenAI
#
# AI_PROVIDER_ORDER=gemini,groq,openrouter,cerebras
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_API_KEY=          # openrouter.ai/keys
# OPENROUTER_MODEL=openrouter/free   # auto free router (specific :free slugs rotate)
# CEREBRAS_API_KEY=            # cloud.cerebras.ai (free tier)
# CEREBRAS_MODEL=gpt-oss-120b
# DEEPSEEK_API_KEY=            # PAID — do not set unless you want billing
# MISTRAL_API_KEY=             # PAID
# OPENAI_API_KEY=              # PAID
