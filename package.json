{
  "name": "chai-n-chapter",
  "version": "1.0.0",
  "description": "A personal book blog platform - chai.n.chapter",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:web:prod": "bash scripts/dev-web-prod-api.sh",
    "dev:web:poll": "npm run dev:poll -w apps/web",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:both": "npm run dev:local",
    "check:local": "bash scripts/check-local.sh",
    "restart:web": "bash scripts/restart-web.sh",
    "restart:api": "bash scripts/restart-api.sh",
    "dev:web:3001": "npm run dev:3001 -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web && echo '' && echo '→ For local dev after a build, run: npm run restart:web' && echo ''",
    "export": "npm run export -w apps/web",
    "export:web": "npm run export -w apps/web",
    "start": "npm run start --workspaces --if-present",
    "start:api": "npm run start -w apps/api",
    "start:web": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "keywords": [
    "book-blog",
    "personal-branding",
    "nextjs",
    "nodejs",
    "mongodb"
  ],
  "author": "Anshika Mishra",
  "license": "ISC",
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
